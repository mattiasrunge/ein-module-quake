#!ts
/** quake-join — the way into a hosted game: the socket a player's page connects to. */
import type { CmdReturn, Command } from '@ein/client';
import type { Seat } from '@quake/api';
import { readServer, seatOf } from '@quake/servers';

const quakeJoin = async (cmd: Command): CmdReturn => {
  const [id] = cmd.args.filter((arg) => !arg.startsWith('-'));
  const fail = async (message: string) => {
    await cmd.writeError(`quake-join: ${message}\n`);
    return 1;
  };
  if (!id) return await fail('which server? quake-servers lists them');
  if (!cmd.env.USER) return await fail('sign in to join a game');
  const info = await readServer(cmd, id);
  if (!info) return await fail(`there is no server ${id}; quake-servers lists them`);
  if (info.state !== 'running') return await fail(`${id} is ${info.state}${info.error ? `: ${info.error}` : ''}`);

  const seat = seatOf(info);
  if (cmd.json) await cmd.writeJSON(seat satisfies Seat);
  else await cmd.writeLn(`connect to ${seat.socket} (mode=rw), and the game to ${seat.address}`);
  return 0;
};

quakeJoin.spec = {
  name: 'quake-join',
  effect: 'read' as const,
  description:
    "The way into a hosted Quake or Quake II game: the server's socket node, which a player's page connects to and carries the game's datagrams both ways over, and the address the game connects to",
  args: [{ name: 'server', type: 'string' as const, description: 'the server\'s id, as quake-servers lists it' }],
  flags: [],
  examples: ['quake-join k3x9'],
  returns: "The server's id, its game's folder, title and engine, its map, the path of its socket, and the address the game connects to.",
};

export default quakeJoin;
