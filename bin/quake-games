#!ts
/** quake-games — the games in the Quake page's folder, with each one's title, paks and music, as the page lists them. */
import type { CmdReturn, Command, NodeAttrs } from '@ein/client';
import type { Game } from '@quake/api';
import { byRank, GAMES, PAK_FILE, titleOf, tracksOf } from '@quake/games';

const quakeGames = async (cmd: Command): CmdReturn => {
  const vfs = cmd.sys.vfs;
  const names = async (path: string) => (await vfs.exists(cmd.access, path)) ? (await vfs.children(cmd.access, path)).map((child) => child.name) : [];
  // A folder's tracks, or none when it has none.
  const musicIn = async (folder: string) => {
    const tracks = tracksOf(await names(folder));
    return Object.keys(tracks).length > 0 ? { folder, tracks } : undefined;
  };

  const games: Game[] = [];
  // No folder yet is no games yet: the page makes it, and the services fill it.
  for (const name of await names(GAMES)) {
    if (name.startsWith('.')) continue;
    const node = await vfs.get(cmd.access, `${GAMES}/${name}`).catch(() => undefined);
    if (node?.type !== 'directory') continue;
    // Quake loads pak0, pak1 and on, and stops at the first number missing.
    const found = new Map<number, string>();
    for (const file of await names(`${GAMES}/${name}`)) {
      const match = PAK_FILE.exec(file);
      if (match) found.set(Number(match[1]), file);
    }
    const paks: string[] = [];
    while (found.has(paks.length)) paks.push(found.get(paks.length)!);
    if (paks.length === 0) continue;
    const sizes = await Promise.all(paks.map(async (pak) => (await vfs.get<NodeAttrs & { size?: number }>(cmd.access, `${GAMES}/${name}/${pak}`)).attrs.size ?? 0));
    const music = await musicIn(`${GAMES}/${name}/music`);
    games.push({ name, title: titleOf(name, sizes), paks, size: sizes.reduce((sum, size) => sum + size, 0), ...(music ? { music } : {}) });
  }
  games.sort(byRank);

  if (cmd.json) await cmd.writeJSON(games satisfies Game[]);
  else for (const game of games) await cmd.writeLn(`${game.name}  ${game.title}  ${game.paks.join(' ')}${game.music ? `  music: ${game.music.folder} (${Object.keys(game.music.tracks).length} tracks)` : ''}`);
  return 0;
};

quakeGames.spec = {
  name: 'quake-games',
  effect: 'read' as const,
  description: `List the games in ${GAMES}, which the Quake page plays: each folder with a pak0.pak, id's Quake first`,
  args: [],
  flags: [],
  examples: ['quake-games'],
  returns: 'One entry per game: its folder name, title, paks in load order, their size in bytes, and its music: the folder it is played from and the file of each track by number.',
};

export default quakeGames;
