#!ts
/** quake-stop — stop a hosted game. */
import type { CmdReturn, Command } from '@ein/client';
import { isAdmin } from '@ein/client';
import { readServer, serverPath, waitFor, writeServer } from '@quake/servers';

/** How long the service may take to stop the server and take its folder away. */
const STOP_MS = 15_000;

const quakeStop = async (cmd: Command): CmdReturn => {
  const [id] = cmd.args.filter((arg) => !arg.startsWith('-'));
  const fail = async (message: string) => {
    await cmd.writeError(`quake-stop: ${message}\n`);
    return 1;
  };
  if (!id) return await fail('which server? quake-servers lists them');
  const info = await readServer(cmd, id);
  if (!info) return await fail(`there is no server ${id}; quake-servers lists them`);
  if (info.startedBy !== cmd.env.USER && !isAdmin(cmd.access)) return await fail(`${id} is ${info.startedBy}'s: only they or an administrator stop it`);
  await writeServer(cmd, { ...info, state: 'stopping' });
  if (!(await waitFor(async () => !(await cmd.sys.vfs.exists(cmd.access, serverPath(id))), STOP_MS))) {
    return await fail(`the quake-server service has not stopped ${id} yet; is it running?`);
  }
  if (!cmd.json) await cmd.writeLn(`${id} stopped`);
  return 0;
};

quakeStop.spec = {
  name: 'quake-stop',
  effect: 'write' as const,
  description: 'Stop a hosted Quake or Quake II game, which drops everyone in it; the one who hosted it or an administrator may',
  args: [{ name: 'server', type: 'string' as const, description: 'the server\'s id, as quake-servers lists it' }],
  flags: [],
  examples: ['quake-stop k3x9'],
  returns: 'Nothing; the server is stopped and its folder gone.',
};

export default quakeStop;
