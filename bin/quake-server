#!ts
/** quake-server — the quake-server service: runs the games people host until it is stopped. */
import type { CmdReturn, Command } from '@ein/client';
import { QuakeService } from '@quake/service';

const quakeServer = async (cmd: Command): CmdReturn => {
  const stopped = new Promise<void>((resolve) => cmd.onInterrupt(resolve));
  await cmd.writeLn('quake-server: running the games people host');
  await new QuakeService(cmd).run(stopped);
  return 0;
};

quakeServer.spec = {
  name: 'quake-server',
  admin: true,
  daemon: true,
  effect: 'write' as const,
  json: false,
  description: 'Run the Quake and Quake II games people host, each a dedicated server, and carry their players\' datagrams (the quake-server service)',
  args: [],
  flags: [],
  examples: ['service restart quake-server'],
};

export default quakeServer;
