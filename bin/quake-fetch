#!bash
# quake-fetch — fetches one of the free games quake-games offers into its games folder, when someone
# chooses Fetch on the Games page or the game's own: Quake's shareware episode, Quake II's demo,
# LibreQuake with its music, Quake III Arena's demo, or OpenArena for Quake 3's engine. The release
# is fetched from where its makers published it, checked against its SHA-256, and unpacked into a
# game folder of its own; a file already there under the same name is left as it is. It runs as
# whoever runs it, which has to be the administrator: EiN lets only the administrator fetch URLs.
arg --desc "Fetch one of the free Quake, Quake II and Quake III games the Games page offers into the games folder"
arg --effect write
arg '<game>' string "shareware (Quake's shareware episode), quake2-demo (Quake II's demo), librequake (LibreQuake and its music), quake3-demo (Quake III Arena's demo) or openarena (OpenArena, for Quake 3's engine)"
arg --example "quake-fetch shareware"
arg --returns "nothing; the game is in a folder of its own in /groups/users/quake, named as the game."
arg --export

games=/groups/users/quake
case "$GAME" in
  shareware)
    # The shareware episode of Quake 1.06 is id Software's, free to play and to pass on unchanged;
    # its release as the Internet Archive keeps it installed.
    url=https://archive.org/download/Quake_802/zQUAKE_SW-play.zip
    sha256=f6db68de2a4b7dd8b250e2d8ab1c9a83ea321fabd2bb63c4c0dd5fed6f69e61a
    ;;
  quake2-demo)
    # The demo of Quake II 3.14 is id Software's, free to play and to pass on, by electronic means and
    # free of charge, with its licence beside it; its release as id published it, a self-extracting
    # zip, from a mirror of id's FTP site.
    url=https://ftp.gwdg.de/pub/misc/ftp.idsoftware.com/idstuff/quake2/q2-314-demo-x86.exe
    sha256=7ace5a43983f10d6bdc9d9b6e17a1032ba6223118d389bd170df89b945a04a1e
    ;;
  librequake)
    # LibreQuake (https://github.com/lavenderdotpet/LibreQuake) is free game data for Quake's engine,
    # its art, sounds and music under a BSD licence and its game code under the GPL; its lite
    # release, the one made for the original engine.
    url=https://github.com/lavenderdotpet/LibreQuake/releases/download/v0.09-beta/lite.zip
    sha256=428e736b2f01d953e09a08c60bee975bdc4a0ac2219e97fa095c8af41754da83
    ;;
  quake3-demo)
    # The demo of Quake III Arena is id Software's, free to copy and to pass on, free of charge and
    # not for profit, with its licence beside it; its release for Linux as id published it, a shell
    # script followed by a gzipped tar, from a mirror of id's FTP site.
    url=https://ftp.gwdg.de/pub/misc/ftp.idsoftware.com/idstuff/quake3/linux/linuxq3ademo-1.11-6.x86.gz.sh
    sha256=64dee3f69b6e792d1da4fe0ac98fedc7eb1e37ea1027fb609a9fadd06150a4ec
    ;;
  openarena)
    # OpenArena 0.8.8 (https://openarena.ws) is a free game for Quake 3's engine, under the GPL; its
    # release for every platform as the Internet Archive keeps it, the same as its makers' mirror
    # (download.tuxfamily.org, which answers over IPv6 first), of which only its game data is kept.
    url=https://archive.org/download/openarena-0.8.8/openarena-0.8.8.zip
    sha256=5a8faf7f5b51f351b0a1618c06b6b98a5f1a6758f1d39818de2c87df2a0bac4a
    ;;
  *)
    echo "quake-fetch: $GAME is not a game it fetches: shareware, quake2-demo, librequake, quake3-demo or openarena" >&2
    exit 2
    ;;
esac
# Quake III's demo is a gzipped tar after a shell script, which takes EiN's tar and a tail that cuts
# bytes, both in EiN since its core 74ec2a05f.
if [ "$GAME" = quake3-demo ] && ! command -v tar > /dev/null; then
  echo "quake-fetch: this EiN has no tar to unpack Quake III's demo with; update EiN first" >&2
  exit 1
fi
game=$games/$GAME
# Fetched and unpacked in a hidden folder of the games folder: on disk, where /tmp would hold a
# release as large as OpenArena's in EiN's memory, and left alone by EiN's media pipelines, as the
# games are. The games list leaves a hidden folder out.
work=$games/.fetch-$GAME

mkdir -p "$games"
# Game data and music, none of it the household's: EiN's media pipelines leave the folder alone.
attrs -J 'processing=[]' "$games"
release=$work.download
if ! curl -fLs -o "$release" "$url"; then
  echo "quake-fetch: could not fetch $url" >&2
  exit 1
fi
if ! attrs "$release" | grep -q "$sha256"; then
  echo "quake-fetch: $url is not the release it should be (its SHA-256 is not $sha256)" >&2
  rm "$release"
  exit 1
fi
# A zip, but Quake III's demo: its installer's shell script is 5468 bytes, and the gzipped tar after
# it holds the demo's pak and its licence.
case "$GAME" in
  quake3-demo) tail -c +5469 "$release" > "$work.tar.gz" && mkdir -p "$work" && tar -xzf "$work.tar.gz" -C "$work" demoq3/pak0.pk3 Help/Q3A_EULA.txt ;;
  *) unzip -o -d "$work" "$release" > /dev/null ;;
esac
unpacked=$?
[ -e "$work.tar.gz" ] && rm "$work.tar.gz"
if [ "$unpacked" != 0 ]; then
  echo "quake-fetch: could not unpack $url" >&2
  rm "$release"
  [ -e "$work" ] && rm -r "$work"
  exit 1
fi

# Move a file of the release into the game's folder, unless one someone uploaded is there already.
mkdir -p "$game"
case "$GAME" in
  shareware)
    [ -e "$game/pak0.pak" ] || mv "$work/ID1/PAK0.PAK" "$game/pak0.pak"
    ;;
  quake2-demo)
    [ -e "$game/pak0.pak" ] || mv "$work/Install/Data/baseq2/pak0.pak" "$game/pak0.pak"
    mv "$work/Install/Data/DOCS/license.txt" "$game/license.txt"
    # The players' models and skins are beside the demo's pak, not in it: other players are drawn with them.
    [ -e "$game/players" ] || mv "$work/Install/Data/baseq2/players" "$game/players"
    ;;
  librequake)
    for pak in pak0.pak pak1.pak; do
      [ -e "$game/$pak" ] || mv "$work/lite/id1/$pak" "$game/$pak"
    done
    mkdir -p "$game/music"
    for track in 02 03 04 05 06 07 08 09 10 11; do
      [ -e "$game/music/track$track.ogg" ] || mv "$work/lite/id1/music/track$track.ogg" "$game/music/track$track.ogg"
    done
    ;;
  quake3-demo)
    [ -e "$game/pak0.pk3" ] || mv "$work/demoq3/pak0.pk3" "$game/pak0.pk3"
    mv "$work/Help/Q3A_EULA.txt" "$game/license.txt"
    ;;
  openarena)
    # Its pk3s but pak2-players-mature, which puts more revealing models of some of its characters in
    # place of pak2-players'; the game is whole without it.
    for pak in pak0 pak1-maps pak2-players pak4-textures pak5-TA pak6-misc pak6-patch085 pak6-patch088; do
      [ -e "$game/$pak.pk3" ] || mv "$work/openarena-0.8.8/baseoa/$pak.pk3" "$game/$pak.pk3"
    done
    ;;
esac
rm -r "$work" "$release"
echo "quake-fetch: $GAME is in $game"
