{
  "name": "quake",
  "version": "0.20.0",
  "description": "Quake, Quake II and Quake III in EiN: quakegeneric (with a WebGL 2 renderer beside its software one), Yamagi Quake II (WebGL 2 or software renderer) and ioquake3 built to WebAssembly, played on the Games page",
  "license": "GPL-2.0-or-later",
  "coreApi": "^0.15.77",
  "dependencies": {
    "games": "^0.1.3-dev.3"
  },
  "exports": {
    "./api": "./lib/api.ts"
  },
  "imports": {
    "@quake/api": "./lib/api.ts",
    "@quake/catalog": "./lib/catalog.ts",
    "@quake/games": "./lib/games.ts",
    "@quake/server": "./lib/server.ts"
  },
  "ui": {
    "workers": {
      "engine": "ui/quake/engine-worker.ts"
    },
    "routes": {
      "/games/quake/:game": "ui/pages/game.tsx",
      "/cards/quake/demo": "ui/cards/demo.tsx"
    }
  }
}
