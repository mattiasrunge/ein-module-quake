{
  "title": "Quake",
  "icon": "/usr/modules/quake/assets/icon.svg",
  "route": "/games/quake",
  "list": "quake-games",
  "fetch": "quake-fetch",
  "folder": "/groups/users/quake",
  "drops": [
    { "place": "module", "label": "a Quake or Quake II game", "contains": "pak0.pak" },
    { "place": "module", "label": "a Quake 3 game", "contains": "pak0.pk3" },
    { "place": "game", "label": "a Quake map", "name": "\\.bsp$", "magic": [{ "at": 0, "hex": "1d000000" }], "into": "maps", "families": ["quake"] },
    { "place": "game", "label": "a Quake II map", "name": "\\.bsp$", "magic": [{ "at": 0, "hex": "4942535026000000" }], "into": "maps", "families": ["quake2"] },
    { "place": "game", "label": "a Quake 3 map", "name": "\\.bsp$", "magic": [{ "at": 0, "hex": "494253502e000000" }], "into": "maps", "families": ["quake3"] },
    { "place": "game", "label": "a Quake III CD key", "name": "^(q3key|key\\.txt)$", "families": ["quake3"] },
    { "place": "game", "label": "a Quake 3 map or mod's pk3", "name": "\\.pk3$", "magic": [{ "at": 0, "hex": "504b0304" }], "families": ["quake3"] },
    { "place": "game", "label": "another pak of a game", "name": "^pak[1-9][0-9]*\\.pak$", "magic": [{ "at": 0, "text": "PACK" }] },
    { "place": "game", "label": "a game's music", "name": "^music$" }
  ],
  "multiplayer": {
    "modes": [{ "value": "deathmatch", "label": "Deathmatch" }, { "value": "coop", "label": "Cooperative" }],
    "maxPlayers": 16,
    "defaultPlayers": 8,
    "defaultMaps": ["q2dm1", "dm3", "dm1", "e1m1", "base1", "demo1", "q3dm17", "oa_dm1"],
    "transport": "server"
  }
}
