+/*
+A connection asked for and not answered yet. id's Datagram_Connect waited
+for the answer in a loop, reading the socket until it came; in a browser
+nothing comes while the game's code runs, so the request is sent here and
+the answer read by Datagram_GetMessage in the frames that follow, as any
+other message is. The client counts as connected meanwhile, and can send
+nothing until the server accepts it.
+*/
+static int connectTries;
+static double connectSent;
+
+// How often, and how many times, the request is sent before giving up.
+#define CONNECT_WAIT	2.5
+#define CONNECT_TRIES	4
+
+static void SendConnectRequest (qsocket_t *sock)
+{
+	byte buffer[64];
+	sizebuf_t request;
+
+	request.allowoverflow = false;
+	request.overflowed = false;
+	request.data = buffer;
+	request.maxsize = sizeof(buffer);
+	request.cursize = 0;
+	// save space for the header, filled in later
+	MSG_WriteLong(&request, 0);
+	MSG_WriteByte(&request, CCREQ_CONNECT);
+	MSG_WriteString(&request, "QUAKE");
+	MSG_WriteByte(&request, NET_PROTOCOL_VERSION);
+	*((int *)request.data) = BigLong(NETFLAG_CTL | (request.cursize & NETFLAG_LENGTH_MASK));
+	net_landrivers[sock->landriver].Write (sock->socket, request.data, request.cursize, &sock->addr);
+	connectTries++;
+	connectSent = net_time;
+}
