# Builds Quake (quakegeneric) to WebAssembly for the module's page: assets/quake.js and
# assets/quake.wasm, single-threaded, with no SDL and no main loop (engine/quakegeneric_ein.c,
# engine/sys_ein.c). The sound is Quake's own mixer, id's snd_dma.c, snd_mem.c and snd_mix.c,
# played by the page (engine/snd_ein.c); the music is the page's (engine/cd_ein.c).
#
#   docker buildx build --file engine/Containerfile --output type=local,dest=assets engine
#
# The local exporter writes the files on the host, so no bind mount needs to be writable.
# Run from the repository's root directory; scripts/build-engine.sh does exactly this.

# emsdk 6.0.13, the multi-platform index (linux/amd64 and linux/arm64).
FROM docker.io/emscripten/emsdk:6.0.13@sha256:fb7864e398acfda863dfcea78b8bc8adad359fa60c6a0bbeb845931de64aa68a AS build

# quakegeneric, pinned. GPL-2.0-or-later, like this module.
ARG QUAKEGENERIC_COMMIT=13052102577c629650cf07a46151a4b6e1b19c3c
RUN git init -q /src \
  && git -C /src fetch -q --depth 1 https://github.com/erysdren/quakegeneric.git ${QUAKEGENERIC_COMMIT} \
  && git -C /src checkout -q FETCH_HEAD

# id Software's Quake source, pinned, for the sound quakegeneric left out: the mixer that paints a
# DMA buffer (snd_dma.c, snd_mix.c) and the loader of the game's WAV files (snd_mem.c).
# GPL-2.0-or-later.
ARG QUAKE_COMMIT=bf4ac424ce754894ac8f1dae6a3981954bc9852d
RUN git init -q /quake \
  && git -C /quake fetch -q --depth 1 https://github.com/id-Software/Quake.git ${QUAKE_COMMIT} \
  && git -C /quake checkout -q FETCH_HEAD \
  && cp /quake/WinQuake/snd_dma.c /quake/WinQuake/snd_mem.c /quake/WinQuake/snd_mix.c /src/source/

# The frame's size is the build's, not quakegeneric's fixed 320 by 240.
COPY resolution.patch /src/
RUN git -C /src apply /src/resolution.patch

# Saving a game and writing config.cfg tell the page, which keeps them in the player's home
# (ein_wrote, quakegeneric_ein.c).
COPY files.patch /src/
RUN git -C /src apply /src/files.patch

# Saving wrote each string of the game code's into a 256-byte buffer, which LibreQuake's longer
# texts overran.
COPY long-strings.patch /src/
RUN git -C /src apply /src/long-strings.patch

WORKDIR /src/source
COPY quakegeneric_ein.c sys_ein.c snd_ein.c cd_ein.c ./

# The engine's sources: quakegeneric's makefile's list without its null system, sound and CD
# drivers and its own start-up, and this build's in their place.
ARG SOURCES="chase cl_demo cl_input cl_main cl_parse cl_tent cmd common console crc cvar d_edge d_fill d_init d_modech d_part d_polyse d_scan d_sky d_sprite d_surf d_vars d_zpoint draw host_cmd host in_null keys mathlib menu model net_loop net_main net_none net_vcr nonintel pr_cmds pr_edict pr_exec r_aclip r_alias r_bsp r_draw r_edge r_efrag r_light r_main r_misc r_part r_sky r_sprite r_surf r_vars sbar screen sv_main sv_move sv_phys sv_user vid_null view wad world zone snd_dma snd_mem snd_mix quakegeneric_ein sys_ein snd_ein cd_ein"

# The frame: 640 by 480, WinQuake's VGA mode, drawn by the software renderer.
ARG WIDTH=640
ARG HEIGHT=480

# Two compilers at a time keep the build's memory small beside a running EiN. Quake's
# Host_Error leaves a frame with longjmp, which Emscripten's own setjmp handles. The glue is
# headed with Deno's ignore comments, so core's `deno fmt` and `deno lint` pass over the
# generated file.
ENV EMCC_CORES=2
RUN mkdir -p /out \
  && emcc -O2 -std=gnu99 -w -DQUAKEGENERIC_RES_X=${WIDTH} -DQUAKEGENERIC_RES_Y=${HEIGHT} \
    $(for name in ${SOURCES}; do echo "${name}.c"; done) \
    -o /out/quake.js \
    -sMODULARIZE=1 -sEXPORT_ES6=1 -sEXPORT_NAME=createQuake \
    -sENVIRONMENT=web \
    -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=128MB -sSTACK_SIZE=1MB \
    -sSUPPORT_LONGJMP=emscripten \
    -sEXPORTED_FUNCTIONS=_ein_start,_ein_tick,_ein_key,_ein_mouse,_ein_write_config,_ein_screen,_ein_width,_ein_height,_ein_frames,_ein_audio_rate,_ein_audio_render,_malloc \
    -sEXPORTED_RUNTIME_METHODS=FS,HEAPU8,HEAP16,HEAPU32,stringToNewUTF8 \
    -sFORCE_FILESYSTEM=1 \
  && { printf '%s\n' '// deno-fmt-ignore-file' '// deno-lint-ignore-file' '// Generated by engine/Containerfile with Emscripten. Do not edit.'; cat /out/quake.js; } > /out/quake.js.new \
  && mv /out/quake.js.new /out/quake.js \
  && echo "quakegeneric ${QUAKEGENERIC_COMMIT} with resolution.patch, files.patch and long-strings.patch, id Software's Quake ${QUAKE_COMMIT}'s WinQuake sound, ${WIDTH}x${HEIGHT}, emsdk 6.0.13" > /out/quake-build.txt

FROM scratch
COPY --from=build /out/ /
