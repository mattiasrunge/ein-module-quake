# Builds Quake (quakegeneric) to WebAssembly for the module's page: assets/quake.js and
# assets/quake.wasm, single-threaded, with no SDL and no main loop (engine/quakegeneric_ein.c,
# engine/sys_ein.c). The sound is Quake's own mixer, id's snd_dma.c, snd_mem.c and snd_mix.c,
# played by the page (engine/snd_ein.c); the music is the page's (engine/cd_ein.c); the network
# is id's datagram driver over the page's (engine/net_ein.c). Beside it, the same engine as a
# dedicated server without frame or sound (engine/server_ein.c), which the quake-server service
# runs: assets/quake-server.js and assets/quake-server.wasm. The game draws with a WebGL 2 renderer
# of its own (engine/gl_*.c) or with Quake's software renderer, as the player chooses.
#
#   docker buildx build --file engine/Containerfile --output type=local,dest=assets engine
#
# The local exporter writes the files on the host, so no bind mount needs to be writable.
# Run from the repository's root directory; scripts/build-engine.sh does exactly this.

# emsdk 6.0.13, the multi-platform index (linux/amd64 and linux/arm64).
FROM docker.io/emscripten/emsdk:6.0.13@sha256:fb7864e398acfda863dfcea78b8bc8adad359fa60c6a0bbeb845931de64aa68a AS build

# quakegeneric, pinned. GPL-2.0-or-later, like this module.
ARG QUAKEGENERIC_COMMIT=13052102577c629650cf07a46151a4b6e1b19c3c
RUN git init -q /src \
  && git -C /src fetch -q --depth 1 https://github.com/erysdren/quakegeneric.git ${QUAKEGENERIC_COMMIT} \
  && git -C /src checkout -q FETCH_HEAD

# id Software's Quake source, pinned, for the sound quakegeneric left out: the mixer that paints a
# DMA buffer (snd_dma.c, snd_mix.c) and the loader of the game's WAV files (snd_mem.c); and for the
# network it left out, the datagram driver (net_dgrm.c), its line ends made Unix's.
# GPL-2.0-or-later.
ARG QUAKE_COMMIT=bf4ac424ce754894ac8f1dae6a3981954bc9852d
RUN git init -q /quake \
  && git -C /quake fetch -q --depth 1 https://github.com/id-Software/Quake.git ${QUAKE_COMMIT} \
  && git -C /quake checkout -q FETCH_HEAD \
  && cp /quake/WinQuake/snd_dma.c /quake/WinQuake/snd_mem.c /quake/WinQuake/snd_mix.c /src/source/ \
  && for file in net_dgrm.c net_dgrm.h; do tr -d '\r' < /quake/WinQuake/$file > /src/source/$file; done

# The frame's size is the mode the player chooses in Video Options, up to the build's largest, not
# quakegeneric's fixed 320 by 240; a wider frame sees more at its sides (fov is for 4:3). Video
# Options also turns fullscreen on and off, which the page follows. The buffer
# the view is drawn into under water is the largest frame's, which was 320 by 200 on the stack while
# quakegeneric let the view be as large as the frame.
COPY resolution.patch /src/
RUN git -C /src apply /src/resolution.patch

# The menus, the status bar and the console keep their size on any frame: they are drawn on a 2D
# screen of the frame divided by a whole number, the frame's height in 480s unless vid_scale sets it,
# each of their pixels a block of the frame's.
COPY scale.patch /src/
RUN git -C /src apply /src/scale.patch

# Saving a game and writing config.cfg tell the page, which keeps them in the player's home
# (ein_wrote, quakegeneric_ein.c).
COPY files.patch /src/
RUN git -C /src apply /src/files.patch

# Saving wrote each string of the game code's into a 256-byte buffer, which LibreQuake's longer
# texts overran.
COPY long-strings.patch /src/
RUN git -C /src apply /src/long-strings.patch

# Connecting waited for answers in loops, which nothing answers in a browser while the game's code
# runs: an address is connected to without first searching the LAN for games, and the datagram
# driver sends its connection request and reads the answer in the frames after. The searches' poll
# functions also take the argument they are called with, which WebAssembly holds them to.
COPY connect.patch /src/
RUN git -C /src apply /src/connect.patch

# Games are joined and started from EiN's page, so the main menu's Multiplayer opens the player's
# setup, name and colours, and Escape there goes back to the main menu: the menu of joining and
# starting a game is not shown.
COPY menu.patch /src/
RUN git -C /src apply /src/menu.patch

# Customize controls has the previous weapon (impulse 12) beside the next, and Options turns the
# crosshair on and off.
COPY controls.patch /src/
RUN git -C /src apply /src/controls.patch

# The WebGL 2 renderer (gl_*.c) draws in place of the software renderer while the player has chosen it
# (vid_renderer, Video Options): R_RenderView, R_NewMap and the particles hand over to it, the BSP's
# textures and surfaces keep what it built of them, and Video Options chooses the renderer and its
# filtering.
COPY webgl.patch /src/
RUN git -C /src apply /src/webgl.patch

# id's maps were vised as if their liquids were walls: the server sends what a leaf sees through them
# too (watervis_ein.c), so what is behind translucent water is there to draw.
COPY watervis.patch /src/
RUN git -C /src apply /src/watervis.patch

# Each entity keeps what the WebGL renderer blends its poses and moves with, and whether the server
# moves it in steps (U_NOLERP), whose moves are blended.
COPY lerp.patch /src/
RUN git -C /src apply /src/lerp.patch

# FitzQuake's protocol 666, as QuakeSpasm speaks it, beside id's 15: the larger limits (8192 edicts,
# 4096 models, 2048 sounds, 64000-byte messages, 4096 static entities), entity alpha, fog and
# skyboxes from the server. The server speaks 666 unless sv_protocol 15; the client plays either,
# and id's protocol 15 demos.
COPY protocol.patch /src/
RUN git -C /src apply /src/protocol.patch

# BSP2 and 2PSB maps, and BSP 29 maps past 32767 clipnodes or nodes, as QuakeSpasm loads them.
COPY bsp2.patch /src/
RUN git -C /src apply /src/bsp2.patch

WORKDIR /src/source
COPY quakegeneric_ein.c sys_ein.c snd_ein.c cd_ein.c net_ein.c server_ein.c watervis_ein.c build.sh ./
COPY gl_ein.h gl_local.h gl_main.c gl_world.c gl_models.c gl_shaders.c gl_sky.c gl_null.c ./

# The game and its dedicated server (build.sh). Two compilers at a time keep the build's memory small
# beside a running EiN.
ENV EMCC_CORES=2
RUN sh build.sh \
  && echo "quakegeneric ${QUAKEGENERIC_COMMIT} with resolution.patch, scale.patch, files.patch, long-strings.patch, connect.patch, menu.patch, controls.patch, webgl.patch, watervis.patch, lerp.patch, protocol.patch and bsp2.patch, id Software's Quake ${QUAKE_COMMIT}'s WinQuake sound and datagram driver, modes up to 1920x1200, a WebGL 2 renderer beside the software one: the game and its dedicated server; emsdk 6.0.13" > /out/quake-build.txt

FROM scratch
COPY --from=build /out/ /
