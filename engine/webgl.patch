-#define VID_LINE_Y(i)	(32 + ((i) + ((i) == VID_FULLSCREEN)) * 8)
+#define VID_RENDERER	(VID_NUM_MODES + 1)
+#define VID_FILTER		(VID_NUM_MODES + 2)
+#define VID_LAST		VID_FILTER
+#define VID_LINE_Y(i)	(32 + ((i) + ((i) >= VID_FULLSCREEN)) * 8)
 
