+// Which renderer draws the frames: WebGL 2 ("gl", gl_main.c) or the
+// software one ("soft"); and how WebGL filters the textures: "linear",
+// trilinear between mip levels, or "nearest", the software renderer's look.
+// config.cfg keeps both. A browser without WebGL 2 draws with the software
+// renderer whatever vid_renderer says.
+cvar_t	vid_renderer = {"vid_renderer", "gl", true};
+cvar_t	gl_filter = {"gl_filter", "linear", true};
+
 // The line Video Options' cursor is on: a mode, or VID_FULLSCREEN, the line
-// after the modes and a blank one.
+// after the modes and a blank one, then the renderer's and the filtering's.
 static int	vid_cursor;
 
