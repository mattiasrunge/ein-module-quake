# Builds Quake 2 (quake2generic) to WebAssembly for the module's page: assets/quake2.js and
# assets/quake2.wasm, single-threaded, with no SDL and no main loop (quake2generic_ein.c). The game
# code, id's baseq2, is linked in, and the software renderer draws the frame. The sound is Quake 2's
# own mixer, played by the page (snd_ein.c); the music is the page's (cd_ein.c); the network is the
# page's too (net_ein.c). Beside it, the same engine as a dedicated server without client, renderer
# or sound (server_ein.c), which the quake-server service runs: assets/quake2-server.js and
# assets/quake2-server.wasm.
#
#   docker buildx build --file engine/quake2/Containerfile --output type=local,dest=assets engine/quake2
#
# The local exporter writes the files on the host, so no bind mount needs to be writable.
# Run from the repository's root directory; scripts/build-engine.sh does exactly this.

# emsdk 6.0.13, the multi-platform index (linux/amd64 and linux/arm64), as Quake's build.
FROM docker.io/emscripten/emsdk:6.0.13@sha256:fb7864e398acfda863dfcea78b8bc8adad359fa60c6a0bbeb845931de64aa68a AS build

# quake2generic, pinned: id Software's Quake 2 with the game and the renderer linked in.
# GPL-2.0-or-later, like this module.
ARG QUAKE2GENERIC_COMMIT=84f34ed5382323d96b81a44a44f73496791084a3
RUN git init -q /src \
  && git -C /src fetch -q --depth 1 https://github.com/ozkl/quake2generic.git ${QUAKE2GENERIC_COMMIT} \
  && git -C /src checkout -q FETCH_HEAD

# Two of the game code's functions were defined with other parameters than they are called with,
# which WebAssembly stops the game on: the intermission spot's spawn function, and the turret
# driver's death calling the infantry's.
COPY signatures.patch /src/
RUN git -C /src apply /src/signatures.patch

# The mixer looked up an 8-bit sound's volume with the wrong shift, which made every one silent;
# id's own source has the right one.
COPY volume.patch /src/
RUN git -C /src apply /src/volume.patch

# Saving a game copies its levels' files, which takes listing them (id's Sys_FindFirst for
# Linux); and a save slot or config.cfg written tells the page, which keeps them in the player's
# home (ein_wrote, quake2generic_ein.c).
COPY files.patch /src/
RUN git -C /src apply /src/files.patch

WORKDIR /src
COPY quake2generic_ein.c snd_ein.c cd_ein.c net_ein.c server_ein.c build.sh ./

# The game and its dedicated server (build.sh). Two compilers at a time keep the build's memory small
# beside a running EiN.
ENV EMCC_CORES=2
RUN sh build.sh \
  && echo "quake2generic ${QUAKE2GENERIC_COMMIT} with signatures.patch, volume.patch and files.patch: the game, software renderer, and its dedicated server; emsdk 6.0.13" > /out/quake2-build.txt

FROM scratch
COPY --from=build /out/ /
