# Builds Quake 3 (ioquake3) to WebAssembly for the module's page: assets/quake3.js and
# assets/quake3.wasm, single-threaded, with no SDL and no main loop (quake3_ein.c), run in a worker
# of the module's (ui/quake/engine-worker.ts). It draws with ioquake3's OpenGL 2 renderer on WebGL 2
# (glimp_ein.c), into the worker's canvas, each frame of which the page draws onto its own.
# The game code is the game's own QVMs, in its pk3s, which the engine's interpreter runs. The sound
# is Quake 3's own mixer, music included, played by the page (snd_ein.c); the network is the page's
# too (net_ein.c). Beside it, the same engine as a dedicated server without client, renderer or
# sound (server_ein.c), which the quake-server service runs: assets/quake3-server.js and
# assets/quake3-server.wasm.
#
#   docker buildx build --file engine/quake3/Containerfile --output type=local,dest=assets engine/quake3
#
# The local exporter writes the files on the host, so no bind mount needs to be writable.
# Run from the repository's root directory; scripts/build-engine.sh does exactly this.

# emsdk 6.0.13, the multi-platform index (linux/amd64 and linux/arm64), as Quake's build.
FROM docker.io/emscripten/emsdk:6.0.13@sha256:fb7864e398acfda863dfcea78b8bc8adad359fa60c6a0bbeb845931de64aa68a AS build

# ioquake3, pinned. GPL-2.0-or-later, like this module.
ARG IOQ3_COMMIT=52088b9eae247d8e321c8dc1fb49a879652854f9
RUN git init -q /src \
  && git -C /src fetch -q --depth 1 https://github.com/ioquake/ioq3.git ${IOQ3_COMMIT} \
  && git -C /src checkout -q FETCH_HEAD

# The page starts the game and runs each of its frames, so the system layer's main is Sys_Main,
# which sets the game up and returns, without SDL, which is not linked.
COPY main.patch /src/
RUN git -C /src apply /src/main.patch

# A frame that is not due yet returns at once rather than waiting for its time, which would hold up
# the browser, or a server's worker, until then.
COPY frame.patch /src/
RUN git -C /src apply /src/frame.patch

# q3config.cfg, or the CD key in q3key, written tells the page, which keeps it in the player's home
# (Sys_Wrote, quake3_ein.c).
COPY config.patch /src/
RUN git -C /src apply /src/config.patch

# A game played standalone, id's demo or a game of its own as OpenArena is, has no CD key, so its
# menus do not ask for one; id's whole game asks for the player's own, as Quake III Arena did.
COPY cdkey.patch /src/
RUN git -C /src apply /src/cdkey.patch

# A QVM's cast of a float to an int truncates, as C's does and as on x86; ioquake3's interpreter
# rounds it elsewhere (lrintf), which threw off the game code's arithmetic, its menus' aspect ratios
# among it.
COPY truncate.patch /src/
RUN git -C /src apply /src/truncate.patch

# The menus' Setup > System lists the modes the engine offers (r_availableModes, glimp_ein.c),
# widescreen ones too, and has no GL driver, extensions, colour depth or texture bits to choose,
# which the page's WebGL has one of; its Graphics Settings set the quality, not the mode or
# fullscreen.
COPY graphics.patch /src/
RUN git -C /src apply /src/graphics.patch

WORKDIR /src/code
COPY quake3_ein.c glimp_ein.c snd_ein.c net_ein.c server_ein.c ein/
COPY build.sh ./

# The game and its dedicated server (build.sh). Two compilers at a time keep the build's memory small
# beside a running EiN.
ENV EMCC_CORES=2
RUN sh build.sh

# OpenArena 0.8.8's game code, its menus' source, pinned: the head of its 0.8.8 branch, from which
# its pak6-patch088.pk3 was built. GPL-2.0-or-later. Its Setup > System is patched as Quake III's,
# keeping its flares and anisotropy.
ARG OPENARENA_COMMIT=db7dfa574c291dd0a73a8341397f0a9de448aefd
RUN git init -q /oa \
  && git -C /oa fetch -q --depth 1 https://github.com/OpenArena/gamecode.git ${OPENARENA_COMMIT} \
  && git -C /oa checkout -q FETCH_HEAD
COPY openarena-graphics.patch /oa/
RUN git -C /oa apply /oa/openarena-graphics.patch

# The game code the module brings, as QVMs (qvms.sh): ioquake3's own for Quake III Arena, compiled
# from its source with its own compiler (its CMake, with the image's gcc for the compiler itself),
# its menus (quake3-ui.pk3), which id's demo and whole game are played with, and its cgame and
# qagame (quake3-game.pk3), which the demo is played with, as ioquake3 says to: the demo's own are
# older than ioquake3 runs; and OpenArena's menus (openarena-ui.pk3), compiled with the same compiler.
COPY qvms.sh ./
RUN cmake -S /src -B /qvm -DCMAKE_BUILD_TYPE=Release -DBUILD_CLIENT=OFF -DBUILD_SERVER=OFF -DBUILD_GAME_LIBRARIES=OFF \
    -DBUILD_GAME_QVMS=ON -DBUILD_RENDERER_GL1=OFF -DBUILD_RENDERER_GL2=OFF > /dev/null \
  && cmake --build /qvm -j2 > /dev/null \
  && sh qvms.sh \
  && echo "ioquake3 ${IOQ3_COMMIT} with main.patch, frame.patch, config.patch, cdkey.patch, truncate.patch and graphics.patch: the game, OpenGL 2 renderer on WebGL 2, in a worker, and its dedicated server; its baseq3 menus (quake3-ui.pk3) and game code (quake3-game.pk3) as QVMs; OpenArena ${OPENARENA_COMMIT}'s menus with openarena-graphics.patch (openarena-ui.pk3); emsdk 6.0.13" > /out/quake3-build.txt

FROM scratch
COPY --from=build /out/ /
