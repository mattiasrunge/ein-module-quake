+/*
+=============
+Draw_Block
 
-	r_rectdesc.width = draw_backtile->width;
-	r_rectdesc.height = draw_backtile->height;
-	r_rectdesc.ptexbytes = draw_backtile->data;
-	r_rectdesc.rowbytes = draw_backtile->width;
+Draws `width` by `height` of a picture's pixels, `rowbytes` apart, at (x, y)
+on the 2D screen, each as a draw_scale by draw_scale block of the frame: all
+of them, or with `transparent` not -1 all but those of that colour, through
+`translation` when there is one.
+=============
+*/
+static void Draw_Block (int x, int y, int width, int height, byte *source, int rowbytes, int transparent, byte *translation)
+{
+	byte	*dest, *row;
+	int		u, v, pixel;
+	int		scale = draw_scale;
+
+	dest = vid.buffer + y * scale * vid.rowbytes + x * scale;
+	for (v = 0 ; v < height * scale ; v++, dest += vid.rowbytes)
+	{
+		row = source + (v / scale) * rowbytes;
+		for (u = 0 ; u < width * scale ; u++)
+		{
+			pixel = row[u / scale];
+			if (pixel == transparent)
+				continue;
+			dest[u] = translation ? translation[pixel] : pixel;
+		}
+	}
 }
 
 
