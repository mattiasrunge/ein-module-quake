+/*
+================
+VID_Scale
+
+The 2D's scale on a frame of `width` by `height`.
+================
+*/
+static int VID_Scale (int width, int height)
+{
+	int		scale;
+
+	scale = vid_scale.value >= 1 ? (int) vid_scale.value : (height + 240) / 480;
+	while (scale > 1 && (width / scale < 320 || height / scale < 200))
+		scale--;
+	return scale < 1 ? 1 : scale;
+}
+
