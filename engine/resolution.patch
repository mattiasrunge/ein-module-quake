+/*
+====================
+AdaptFovx
+
+The horizontal field of view that shows as much from top to bottom as fov_x
+does on a 4:3 frame: a wider frame sees more at its sides, not less above
+and below.
+====================
+*/
+static float AdaptFovx (float fov_x, float width, float height)
+{
+	float	a;
+
+	a = atan (0.75 * width / height * tan (fov_x / 360 * M_PI));
+
+	return a * 360 / M_PI;
+}
