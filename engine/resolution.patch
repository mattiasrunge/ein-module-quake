+/*
+================
+VID_SetFrame
+
+Draws from now on into a frame of `width` by `height`. The surfaces cached
+for the old frame are dropped before their cache is.
+================
+*/
+static void VID_SetFrame (int width, int height)
+{
+	int		i;
+	int		size;
+
+	D_FlushCaches ();
+	free (vid_buffer);
+	free (zbuffer);
+	free (surfcache);
+
+	vid.width = vid.conwidth = width;
+	vid.height = vid.conheight = height;
+	vid_buffer = malloc (width * height);
+	vid.buffer = vid.conbuffer = vid_buffer;
+	vid.rowbytes = vid.conrowbytes = width;
+
+	zbuffer = malloc (width * height * sizeof (short));
+	d_pzbuffer = zbuffer;
+
+	size = D_SurfaceCacheForRes (width, height);
+	surfcache = malloc (size);
+	D_InitCaches (surfcache, size);
+
+	vid.recalc_refdef = 1;
+	if (con_initialized)
+		Con_CheckResize ();
+
+	for (i = 0 ; i < VID_NUM_MODES ; i++)
+		if (vid_modes[i].width == width && vid_modes[i].height == height)
+			vid_cursor = i;
+}
+
+/*
+================
+VID_AskMode
+
+Sets vid_width and vid_height, as whole numbers, which config.cfg keeps.
+================
+*/
+static void VID_AskMode (int width, int height)
+{
+	Cvar_Set ("vid_width", va ("%i", width));
+	Cvar_Set ("vid_height", va ("%i", height));
+}
+
+/*
+================
+VID_CheckMode
+
+Takes the mode vid_width and vid_height ask for, once it fits the build;
+asked for one that does not, they go back to the mode there is.
+================
+*/
+static void VID_CheckMode (void)
+{
+	int		width = (int) vid_width.value;
+	int		height = (int) vid_height.value;
+
+	if (width == vid.width && height == vid.height)
+		return;
+	if (width < 320 || width > QUAKEGENERIC_RES_X || height < 200 || height > QUAKEGENERIC_RES_Y)
+	{
+		Con_Printf ("%ix%i is not a mode: from 320x200 to %ix%i\n", width, height, QUAKEGENERIC_RES_X, QUAKEGENERIC_RES_Y);
+		VID_AskMode (vid.width, vid.height);
+		return;
+	}
+	VID_SetFrame (width, height);
+}
+
+/*
+================
+VID_MenuDraw
+
+Video Options: the modes, the one played in white, whether the frame is
+fullscreen, and the cursor.
+================
+*/
+static void VID_MenuDraw (void)
+{
+	static int	has_title = -1;
+	int		i, handle, y;
+	char	line[32];
+	qpic_t	*p;
+
+	// Not every game has the title's picture; those without have Options'.
+	if (has_title < 0)
+	{
+		has_title = COM_OpenFile ("gfx/vidmodes.lmp", &handle) != -1;
+		if (has_title)
+			COM_CloseFile (handle);
+	}
+	M_DrawTransPic (16, 4, Draw_CachePic ("gfx/qplaque.lmp"));
+	p = Draw_CachePic (has_title ? "gfx/vidmodes.lmp" : "gfx/p_option.lmp");
+	M_DrawPic ((320 - p->width) / 2, 4, p);
+
+	for (i = 0 ; i < VID_NUM_MODES ; i++)
+	{
+		y = VID_LINE_Y (i);
+		sprintf (line, "%4i x %-4i  %s", vid_modes[i].width, vid_modes[i].height, vid_modes[i].shape);
+		if (vid_modes[i].width == vid.width && vid_modes[i].height == vid.height)
+			M_PrintWhite (88, y, line);
+		else
+			M_Print (88, y, line);
+	}
+	M_Print (88, VID_LINE_Y (VID_FULLSCREEN), "Fullscreen");
+	M_DrawCheckbox (184, VID_LINE_Y (VID_FULLSCREEN), vid_fullscreen.value);
+	M_DrawCharacter (72, VID_LINE_Y (vid_cursor), 12 + ((int) (realtime * 4) & 1));
+}
+
+static void VID_MenuKey (int key)
+{
+	switch (key)
+	{
+	case K_ESCAPE:
+		S_LocalSound ("misc/menu1.wav");
+		M_Menu_Options_f ();
+		break;
+
+	case K_UPARROW:
+		S_LocalSound ("misc/menu1.wav");
+		if (--vid_cursor < 0)
+			vid_cursor = VID_FULLSCREEN;
+		break;
+
+	case K_DOWNARROW:
+		S_LocalSound ("misc/menu1.wav");
+		if (++vid_cursor > VID_FULLSCREEN)
+			vid_cursor = 0;
+		break;
+
+	case K_LEFTARROW:
+	case K_RIGHTARROW:
+		if (vid_cursor != VID_FULLSCREEN)
+			break;
+		// Left and right turn fullscreen on and off, as Enter does.
+	case K_ENTER:
+		S_LocalSound ("misc/menu2.wav");
+		if (vid_cursor == VID_FULLSCREEN)
+			Cvar_SetValue ("vid_fullscreen", !vid_fullscreen.value);
+		else
+			VID_AskMode (vid_modes[vid_cursor].width, vid_modes[vid_cursor].height);
+		break;
+	}
+}
